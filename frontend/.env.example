# Lectura directa de Supabase desde el frontend.
# Supabase → Project Settings → API → Project URL y Publishable (anon) key.
# Estas mismas dos variables hay que cargarlas en Vercel (Project → Settings → Environment Variables).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# (Opcional) Si en vez de Supabase directo usás el backend Express, apuntá acá su URL:
# VITE_API_URL=https://tu-backend.onrender.com
