PORT=3001
FRONTEND_URL=http://localhost:5173

ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Solo para scripts/conectar-seller.mjs: tiene que ser EXACTAMENTE la misma
# URL que registraste en Mercado Libre → Mis aplicaciones → tu app → editar
# → "URIs de redirect".
# ML_REDIRECT_URI=http://localhost:8934/callback

# Dominio de autorización de ML según el país de la cuenta (default: Argentina)
# ML_AUTH_DOMAIN=auth.mercadolibre.com.ar

# Connection string PostgreSQL (Supabase → Settings → Database → Connection string → URI)
# Ejemplo pooler: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Secreto para firmar JWT de autenticación (al menos 32 caracteres)
JWT_SECRET=

# Duración del access token (ej. 15m, 1h). Corto a propósito: la sesión se
# mantiene viva mediante el refresh token en cookie httpOnly.
JWT_EXPIRES_IN=15m

# Días de validez del refresh token (cookie httpOnly, tabla refresh_tokens)
REFRESH_TOKEN_TTL_DAYS=30

# Debe ser "production" en Vercel para que la cookie de refresh viaje con
# el flag Secure (requerido por HTTPS); en local dejar sin definir.
NODE_ENV=
