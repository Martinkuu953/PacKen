PORT=3001
FRONTEND_URL=http://localhost:5173

# Secreto para firmar los JWT (generar uno propio, p.ej. con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Connection string PostgreSQL (Supabase → Settings → Database → Connection string → URI)
# Ejemplo pooler: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
